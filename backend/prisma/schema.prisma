generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int           @id @default(autoincrement())
  name     String
  document String        @unique
  email    String        @unique
  password String
  role     Role
  roletype RoleType?
  company  CompanyStack?
  phone    String?
  isActive Boolean       @default(true)

  departures      TransportTrip[]          @relation("transportLogDeparture")
  arrivals        TransportTrip[]          @relation("transportLogArrival")
  pendingArrivals TransportArrivalPending[]

  createdAt DateTime @default(now())
}

model Owner {
  id          Int     @id @default(autoincrement())
  ruc         String? @unique
  companyname String?
  name        String?
  document    String? @unique
  province    String?
  canton      String?
  address     String?
  email       String? @unique
  phone       String?
  isActive    Boolean @default(true)

  vehicles Vehicle[]
  trips    TransportTrip[]
  reports  Report[]
}

model Vehicle {
  id Int @id @default(autoincrement())

  vehicleid String         @unique
  qrcodeId  Int?           @unique
  qrcode    VehicleQRCode? @relation(fields: [qrcodeId], references: [id])

  plate       String          @unique
  brand       String
  model       String
  year        String
  type        VehicleType
  capacity    Float
  company     VehicleCompany?
  observation String?

  driverId  Int?              @unique
  driver    Driver?           @relation("VehicleToDriver", fields: [driverId], references: [id])
  ownerId   Int?
  owner     Owner?            @relation(fields: [ownerId], references: [id])
  plannings PlanningVehicle[]
  trips     TransportTrip[]

  pendingArrivals TransportArrivalPending[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model VehicleQRCode {
  id Int @id @default(autoincrement())

  qrcode String       @unique
  url    String
  status QRCodeStatus @default(DISPONIBLE)

  vehicle Vehicle?

  createdAt DateTime @default(now())
}

model VehicleSequence {
  id     Int    @id @default(autoincrement())
  prefix String @unique
  last   Int
}

model Client {
  id          Int        @id @default(autoincrement())
  name        String
  ruc         String     @unique
  companyname String     @unique
  province    String?
  canton      String?
  address     String?
  type        ClientType
  email       String?
  phone       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  constSites ClientConstSite[]
  plannings  Planning[]
  trips      TransportTrip[]
  reports    Report[]
}

model ConstSite {
  id         Int      @id @default(autoincrement())
  name       String
  province   String?
  canton     String?
  address    String?
  value      Float?
  quarryDist Float?
  abscisa    Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  clients   ClientConstSite[]
  plannings Planning[]
  trips     TransportTrip[]
}

model ClientConstSite {
  id          Int @id @default(autoincrement())
  clientId    Int
  constSiteId Int

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  constSite ConstSite @relation(fields: [constSiteId], references: [id], onDelete: Cascade)

  @@unique([clientId, constSiteId])
}

model PlanningSequence {
  id   Int @id @default(autoincrement())
  year Int @unique
  last Int @default(0)
}

model Planning {
  id            Int            @id @default(autoincrement())
  planningCode  String         @unique
  description   String?
  numeroFactura String?
  invoicePath   String?
  startDate     DateTime
  endDate       DateTime?
  status        PlanningStatus @default(EN_PROGRESO)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  /// Distancia estimada cantera-obra en km. Informativo: NO se usa en el
  /// cálculo de emparejamiento de viajes (solo tiempoPromedioViajeMin).
  distanciaAproximadaKm Float?
  /// Duración esperada del trayecto cantera->obra, en minutos. Único campo
  /// que usa el algoritmo de reconciliación para calcular la ventana de
  /// llegada esperada de cada salida. Nullable: si falta, esos viajes solo
  /// se pueden emparejar manualmente.
  tiempoPromedioViajeMin Int?

  clientId    Int
  constSiteId Int

  client    Client            @relation(fields: [clientId], references: [id])
  constSite ConstSite         @relation(fields: [constSiteId], references: [id])
  vehicles  PlanningVehicle[]
  canteras  PlanningCantera[]
  trips     TransportTrip[]
}

model PlanningVehicle {
  id         Int  @id @default(autoincrement())
  planningId Int
  vehicleId  Int
  /// Cantera desde la que despacha este vehículo. Si la planificación tiene una
  /// sola cantera se asigna sola; queda opcional por los registros ya existentes.
  canteraId  Int?

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  cantera  Cantera? @relation(fields: [canteraId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([planningId])
  @@index([canteraId])
}

model PlanningCantera {
  id         Int @id @default(autoincrement())
  planningId Int
  canteraId  Int

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  cantera  Cantera  @relation(fields: [canteraId], references: [id], onDelete: Cascade)

  @@unique([planningId, canteraId])
  @@index([canteraId])
  @@index([planningId])
}

enum RecordSource {
  ONLINE
  OFFLINE
  MIGRATED
}

model TransportTrip {
  id   Int    @id @default(autoincrement())
  uuid String @unique @db.Uuid // == clientUuid de la salida

  userId        Int
  userArrivalId Int?
  vehicleId     Int
  ownerId       Int?
  clientId      Int
  constSiteId   Int
  planningId    Int?
  materialId    Int?
  /// Cantera de la que salió el material en este viaje. Es el eslabón que
  /// permite saber a qué stock descontar.
  canteraId     Int?
  /// Conductor que hizo el viaje, capturado al registrar la salida. El
  /// conductor del vehículo puede cambiar después, así que sin esta foto el
  /// historial atribuiría los viajes viejos al conductor actual.
  driverId      Int?
  userRoleType  UserRoleType?
  numeroFactura String?

  departureAt DateTime // espejo de departure.capturedAt
  arrivalAt   DateTime? // espejo de arrival.capturedAt

  deviationM3   Float?
  observation   String?
  status        TransportStatus  @default(EN_PROGRESO)
  initialStatus TransportStatus?

  /// Espejo de (departure.almuerzo OR arrival.almuerzo): true si el chofer
  /// se fue a almorzar en algún punto de este viaje. Se resta 1h del tiempo
  /// esperado al calcular la ventana de emparejamiento cuando aplica.
  almuerzoAplicado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User      @relation("transportLogDeparture", fields: [userId], references: [id])
  userArrival User?     @relation("transportLogArrival", fields: [userArrivalId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  owner       Owner?    @relation(fields: [ownerId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  constSite   ConstSite @relation(fields: [constSiteId], references: [id])
  planning    Planning? @relation(fields: [planningId], references: [id])
  material    Material? @relation(fields: [materialId], references: [id])
  cantera     Cantera?  @relation(fields: [canteraId], references: [id], onDelete: SetNull)
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  departure       TransportDeparture?
  arrival         TransportArrival?
  movimientoStock CanteraMaterialMovimiento?
  matchedFrom     TransportArrivalPending?

  @@index([vehicleId, status, departureAt])
  @@index([departureAt])
  @@index([arrivalAt])
  @@index([canteraId])
  @@index([driverId])
}

model TransportDeparture {
  id     Int           @id @default(autoincrement())
  tripId Int           @unique
  trip   TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  clientUuid String       @unique @db.Uuid // IDEMPOTENCIA (reintentos del mismo envío)
  source     RecordSource @default(ONLINE)
  capturedAt DateTime // momento real en el teléfono
  receivedAt DateTime     @default(now()) // momento de sincronización

  userId      Int
  m3          Float
  m3Corrected Float?
  lat         Float
  lng         Float

  /// Marcado por el supervisor de cantera si notó que el chofer se fue a
  /// almorzar durante este viaje (1h fija, se descuenta en el emparejamiento).
  almuerzo Boolean @default(false)

  /// Observación escrita por el supervisor de cantera al registrar la salida.
  observation String?

  driverPhoto    String?
  vehiclePhoto   String?
  platePhoto     String?
  materialPhoto1 String?
  materialPhoto2 String?
}

model TransportArrival {
  id     Int           @id @default(autoincrement())
  tripId Int           @unique
  trip   TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  clientUuid String       @unique @db.Uuid
  source     RecordSource @default(ONLINE)
  capturedAt DateTime
  receivedAt DateTime     @default(now())

  userId      Int
  m3          Float
  m3Corrected Float?
  lat         Float?
  lng         Float?
  abscisa     Int?

  /// Marcado por el supervisor de obra si notó que el chofer se fue a
  /// almorzar durante este viaje (1h fija, se descuenta en el emparejamiento).
  almuerzo Boolean @default(false)

  /// Observación escrita por el supervisor de obra al registrar la llegada.
  observation String?

  driverPhoto    String?
  vehiclePhoto   String?
  platePhoto     String?
  materialPhoto1 String?
  materialPhoto2 String?
}

/// Llegadas que sincronizaron al servidor sin que su salida correspondiente
/// haya llegado todavía (ambos supervisores registran offline, en celulares
/// distintos, sin verse entre sí). Se resuelven después contra TransportTrip
/// por placa + ventana de tiempo (ver reconciliation/). No se borra al hacer
/// match: matchedTripId + status=EMPAREJADO quedan como bitácora auditable.
model TransportArrivalPending {
  id         Int          @id @default(autoincrement())
  clientUuid String       @unique @db.Uuid
  source     RecordSource @default(ONLINE)
  capturedAt DateTime
  receivedAt DateTime     @default(now())

  vehicleId   Int
  userId      Int
  m3          Float
  m3Corrected Float?
  lat         Float?
  lng         Float?
  abscisa     Int?
  almuerzo    Boolean @default(false)

  /// Observación escrita por el supervisor de obra al registrar la llegada;
  /// viaja con la fila de staging hasta que se empareja con su salida.
  observation String?

  driverPhoto    String?
  vehiclePhoto   String?
  platePhoto     String?
  materialPhoto1 String?
  materialPhoto2 String?

  status        PendingArrivalStatus @default(PENDIENTE)
  matchedTripId Int?                 @unique
  matchedTrip   TransportTrip?       @relation(fields: [matchedTripId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([vehicleId, status, capturedAt])
}

model Report {
  id         Int          @id @default(autoincrement())
  ownerId    Int?
  clientId   Int?
  startDate  DateTime
  endDate    DateTime
  status     ReportStatus @default(NORMAL)
  reportData Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  owner  Owner?  @relation(fields: [ownerId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
}

model DailyStats {
  id                   Int      @id @default(autoincrement())
  date                 String   @unique
  totalDeparturesCount Int      @default(0)
  totalArrivalsCount   Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Material {
  id           Int             @id @default(autoincrement())
  /// Único: el catálogo no debe tener el mismo material dos veces. Permite
  /// sembrar con upsert sin duplicar y conservando el id de los ya existentes.
  materialType MaterialType    @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  trips        TransportTrip[]

  canteraMateriales CanteraMaterial[]
}

model MaterialProvider {
  id              Int            @id @default(autoincrement())
  ruc             String?        @unique
  razonsocial     String?
  nombreComercial String?
  /// INTERNO = cantera propia de la empresa, EXTERNO = proveedor de terceros.
  tipo            ProveedorTipo?
  email           String?        @unique
  provincia       String?
  canton          String?
  direccion       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  canteras Cantera[]
}

model Cantera {
  id                 Int      @id @default(autoincrement())
  nombre             String?
  provincia          String?
  canton             String?
  direccion          String?
  isActive           Boolean  @default(true)
  materialProviderId Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  materialProvider MaterialProvider  @relation(fields: [materialProviderId], references: [id], onDelete: Cascade)
  plannings        PlanningCantera[]
  materiales       CanteraMaterial[]
  planningVehicles PlanningVehicle[]
  trips            TransportTrip[]
}

/// Material que despacha una cantera, con la cantidad asignada y su equivalencia TN <-> M3.
model CanteraMaterial {
  id         Int @id @default(autoincrement())
  canteraId  Int
  materialId Int

  /// Cantidad asignada en toneladas
  toneladas           Float?
  /// Cantidad asignada en metros cúbicos
  metrosCubicos       Float?
  /// Factor de conversión: TN por M3
  factor              Float?
  direccionConversion ConversionDireccion @default(TN_A_M3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cantera     Cantera                     @relation(fields: [canteraId], references: [id], onDelete: Cascade)
  material    Material                    @relation(fields: [materialId], references: [id])
  movimientos CanteraMaterialMovimiento[]

  @@unique([canteraId, materialId])
  @@index([canteraId])
  @@index([materialId])
}

/// Libro mayor de consumo. Un renglón por viaje: el saldo es
/// (cantidad asignada - SUM(movimientos)), nunca un contador mutable.
/// `tripId @unique` hace el descuento idempotente por construcción: un replay
/// del mismo envío no puede duplicar el consumo.
model CanteraMaterialMovimiento {
  id                Int  @id @default(autoincrement())
  canteraMaterialId Int
  /// Null para ajustes manuales sin viaje asociado (Postgres permite varios NULL en un UNIQUE)
  tripId            Int? @unique

  m3        Float
  toneladas Float?
  tipo      MovimientoTipo @default(SALIDA)
  motivo    String?

  /// Momento REAL del despacho (reloj del teléfono), no el de sincronización.
  /// Con la app offline, ordenar por createdAt distorsionaría el histórico.
  capturedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  canteraMaterial CanteraMaterial @relation(fields: [canteraMaterialId], references: [id], onDelete: Cascade)
  trip            TransportTrip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([canteraMaterialId, capturedAt])
  @@index([capturedAt])
}

model Driver {
  id       Int     @id @default(autoincrement())
  name     String?
  document String?
  phone    String?
  isActive Boolean @default(true)

  vehicle Vehicle?        @relation("VehicleToDriver")
  trips   TransportTrip[]
}

/// Código interno del material. El nombre comercial que ve el usuario vive en
/// prisma/data/materiales.json y en MATERIAL_LABELS del frontend, porque tiene
/// caracteres que un enum no admite (#, /, paréntesis, espacios).
///
/// Los 9 primeros son heredados: ya no están en el listado de la empresa pero se
/// conservan porque hay viajes históricos que los referencian.
enum MaterialType {
  ARENA_DE_BANCO
  ARENA_DE_PLAYA
  ARENA_DE_RIO_COLIMES
  BASE
  CISCO_CRUDO
  CISCO_LAVADO
  PIEDRA_BOLA
  RIPIO
  SUB_BASE

  ARENA_DE_MAR
  ARENA_DE_RIO
  ARENA_FINA
  ARENA_FINA_LAVADA
  ARENA_HOMOGENIZADA
  ARENA_LAVADA
  ARENA_LISTA_PARA_HORMIGON
  BASALTO_SAN_CARLOS
  BASALTO_SIN_CLASIFICAR
  BASE_CEMENTO
  BASE_CIUDAD_RODRIGO
  BASE_CLASE_1_A
  CASCAJO
  CASCAJO_CRIBADO
  CISCO
  CISCO_P_TUBERIA
  CRUDO
  ESCOMBROS
  FRESADO
  LASTRE
  MAT_TRITURADO_PARA_RIPIO
  MATERIAL_DE_MEJORAMIENTO
  MEJORAMIENTO
  MEJORAMIENTO_CRIBADO
  MEJORAMIENTO_MTOP
  MEJORAMIENTO_S_C
  MEZCLA_ASFALTICA
  P_BOLON
  PIEDRA_1_2_VSI
  PIEDRA_2_4
  PIEDRA_3_4
  PIEDRA_3_8_VSI
  PIEDRA_4_19_38_MM
  PIEDRA_6
  PIEDRA_6_LAVADA
  PIEDRA_67
  PIEDRA_7
  PIEDRA_7_8
  PIEDRA_8_3_8
  PIEDRA_BASE
  PIEDRA_BLANCA
  PIEDRA_BOLA_BANCO
  PIEDRA_BOLA_SELECCIONADA
  PIEDRA_BOLON
  PIEDRA_DEFENSA
  PIEDRA_ESCOLLERA
  PIEDRA_FILTRANTE
  PIEDRA_FILTRANTE_CAFE
  PIEDRA_HOMO_57
  PIEDRA_TRANSICION
  PIEDRAPLEN
  PRESTAMO_IMPORTADO
  ROCARENA
  SUB_BASE_CLASE_3
  TRITURADO_4_10
}

enum VehicleType {
  INTERNO
  EXTERNO
}

enum ProveedorTipo {
  INTERNO
  EXTERNO
}

/// Sentido en que se aplica el factor: TN_A_M3 divide, M3_A_TN multiplica.
enum ConversionDireccion {
  TN_A_M3
  M3_A_TN
}

enum MovimientoTipo {
  SALIDA
  AJUSTE
  REVERSA
}

enum ReportStatus {
  NORMAL
  ALERTA
  REVISADO
}

enum Role {
  ADMIN
  SUPERVISOR
  JEFE_DE_OBRA
  PLANIFICADOR
}

enum RoleType {
  OBRA
  CANTERA
}

enum ClientType {
  PUBLICO
  PRIVADO
}

enum CompanyStack {
  CIUDAD_RODRIGO
  TRANSVELEZ
  PAXOS
  DISMECTRA
  PETROVELCA
}

enum VehicleCompany {
  CIUDAD_RODRIGO
  TRANSVELEZ
}

enum PlanningStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  CANCELADO
  RETRASADO
}

enum TransportStatus {
  EN_PROGRESO
  COMPLETADO
  CANCELADO
  ALERTA
  REVISADO
  VALIDADO
  /// Salida EN_PROGRESO cuya ventana esperada de llegada ya cerró sin match.
  /// Señal de revisión para el administrador (ej. vehículo averiado). No es
  /// terminal: el emparejamiento automático sigue intentando después.
  PENDIENTE_EMPAREJAMIENTO
}

enum PendingArrivalStatus {
  PENDIENTE
  EMPAREJADO
  /// Informativo (ej. +7 días sin match); sigue siendo emparejable a mano.
  EXPIRADO
}

enum QRCodeStatus {
  DISPONIBLE
  OCUPADO
}

enum UserRoleType {
  ADMIN
  OBRA
  CANTERA
}
